# Copy to .env and paste ONE planner key. .env is gitignored — never commit it.
#
#   cp .env.example .env
#   # paste a key, then restart the server
#
# Every planner drives the IDENTICAL 20 tools. Switching provider changes who
# decides the order of tool calls — never what the product does or finds.
# With no key at all it still runs end to end on a deterministic pipeline.

# ════════════════════════════════════════════════════════════════════
#  PICK ONE  — all free tiers below need no credit card
# ════════════════════════════════════════════════════════════════════

# ── RECOMMENDED: Google Gemini Flash ────────────────────────────────
# Free, no card, strong tool use, reliable.  https://aistudio.google.com/apikey
GEMINI_API_KEY=
# GEMINI_MODEL=gemini-2.5-flash

# ── FASTEST: Groq ───────────────────────────────────────────────────
# Free, no card. Dramatically faster than anything else — the trace
# streams almost instantly, which looks good live.
# https://console.groq.com/keys
GROQ_API_KEY=

# ── Cerebras — comparable speed to Groq ─────────────────────────────
# https://cloud.cerebras.ai/
CEREBRAS_API_KEY=

# ── GitHub Models — frontier models, free with a GitHub account ─────
# Token needs the models:read scope. Tight rate limits.
# https://github.com/settings/tokens
GITHUB_TOKEN=

# ── Mistral — free experimental tier ────────────────────────────────
# https://console.mistral.ai/api-keys/
MISTRAL_API_KEY=

# ── OpenRouter — aggregator; check the model supports tool calling ──
# https://openrouter.ai/keys
OPENROUTER_API_KEY=

# ── Together — free tier on selected models ─────────────────────────
# https://api.together.ai/settings/api-keys
TOGETHER_API_KEY=

# ── Anthropic — best reasoning, but needs paid credit ───────────────
# https://console.anthropic.com/settings/keys
ANTHROPIC_API_KEY=
# ANTHROPIC_WORKSPACE_ID=      # only for org keys not scoped to a workspace

# ── Ollama — entirely local and free; small models sequence tools poorly ──
# OLLAMA_API_KEY=ollama
# OPENAI_COMPAT_MODEL=llama3.1:8b

# ════════════════════════════════════════════════════════════════════
#  Overrides
# ════════════════════════════════════════════════════════════════════
# Pin a planner when several keys are present:
#   anthropic | gemini | groq | cerebras | github | mistral |
#   openrouter | together | ollama | deterministic
# SOVEREIGN_PLANNER=

# Override the model on an OpenAI-compatible provider:
# OPENAI_COMPAT_MODEL=

# ── Real breach-membership checks (separate from the planner) ───────
# ~$3.95/month.  https://haveibeenpwned.com/API/Key
# Without it the tool reports "not checked" and never guesses.
HIBP_API_KEY=
